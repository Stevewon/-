{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quantaex-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // Price-alert tick every 5 min + daily D1 backup at 03:00 UTC.
    // Worker's scheduled() handler inspects event.cron to route.
    "crons": ["*/5 * * * *", "0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quantaex-production",
      "database_id": "5eb4f183-1dfc-4310-8872-07b014078dbc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "quantaex-backups"
    }
  ],
  "vars": {
    "BACKUP_RETENTION_DAYS": "30",

    // ── Company-only TWAP split-sell ───────────────────────────────────────
    // Main site origin the cron worker POSTs each tick to fire due treasury
    // slices (/api/orders/twap-tick). The matching secret TWAP_CRON_SECRET is
    // a DASHBOARD SECRET (set with `wrangler secret put TWAP_CRON_SECRET` on
    // BOTH this worker AND the Pages project — same value), never in-repo.
    "APP_URL": "https://quantaex.io",

    // ── Quantarium chain (coin-family withdrawal broadcaster) ──────────────
    // processQtaWithdrawals() signs + broadcasts one QTA/QX/QKEY withdrawal
    // per */5 tick. These mirror the Pages app's wrangler.jsonc.
    //
    // QTA_CHAIN_DRIVER is pinned to 'real' so `wrangler deploy` keeps it set
    // (a bare deploy would otherwise drop a dashboard-only var). Flip back to
    // 'mock' here if the broadcaster ever needs to be paused.
    "QTA_CHAIN_DRIVER": "real",
    "QTA_CHAIN_ID": "60000",
    "QTA_NETWORK": "qta-mainnet",
    "QTA_RPC_URL": "https://rpc.quantarium.io",
    // Blockscout v2 explorer — the deposit scanner (scanQtaDeposits) reads
    // normalised inbound tx lists from here instead of parsing SPHINCS+ blocks.
    "QTA_EXPLORER_URL": "https://scan.quantarium.io",
    "QTA_HOT_WALLET_ADDRESS": "0xdeB6BFE50EeE8D753313988c6d1E77f95322527b",
    // Final MAIN wallet every QX/QKEY deposit is swept INTO. This is the
    // owner's real main wallet (opened by private key), so the server never
    // needs to sign FROM it — it only receives. Gas for the sweep comes from
    // the mnemonic's index-0 address (0x1C30CFc2…), which must hold a little
    // native QTA for the 2-step gas-fund → forward flow.
    "QTA_SWEEP_DESTINATION": "0xdeB6BFE50EeE8D753313988c6d1E77f95322527b",
    // Manual withdrawal mode ON: withdrawals are paid out by a human operator
    // from the Quantarium wallet app. The cron worker does NOT auto-sign, so
    // the hot wallet address does NOT need to match the mnemonic's index-0.
    // Set to "false" only after wiring server-side signing with a matching key.
    "QTA_MANUAL_WITHDRAWALS": "true",
    "QTA_TOKEN_QX_ADDRESS": "0xad447d42fB065a5b505772235F0c96d27501e6Fb",
    "QTA_TOKEN_QX_DECIMALS": "18",
    "QTA_TOKEN_QKEY_ADDRESS": "0x216621D3b3dB600F35DBf6c5709486dDC8882a16",
    "QTA_TOKEN_QKEY_DECIMALS": "18",

    // ── External deposits (Phase B) — BEP-20 (BSC) USDT ────────────────────
    // scanExtDeposits + extDepositTick watch each per-user address on BSC and
    // credit the user after required confirmations; sweepExtDeposits gas-funds
    // then forwards the whole USDT balance to EXT_SWEEP_DESTINATION (owner's BNB
    // wallet). Only BSC is configured — Ethereum (ERC-20) EXT_ETH_* is left
    // unset on purpose, so resolveNetworks()/resolveSweepNetworks() skip erc20.
    //
    // Explorer is Etherscan V2 (unified multichain, chainid=56). The BSC data
    // needs a PAID Etherscan plan; the API key is a dashboard SECRET below.
    "EXT_BSC_RPC_URL": "https://bsc-dataseed.binance.org",
    "EXT_BSC_EXPLORER_URL": "https://api.etherscan.io/v2/api",
    "EXT_BSC_EXPLORER_FLAVOUR": "etherscan",
    "EXT_BSC_USDT_CONTRACT": "0x55d398326f99059fF775485246999027B3197955",
    "EXT_BSC_USDT_DECIMALS": "18",
    "EXT_BSC_REQUIRED_CONFS": "15",
    // Native BNB top-up sent to a fresh deposit addr so it can pay gas for the
    // USDT sweep. 0.0008 BNB — plenty for one BEP-20 transfer (~0.00021 BNB).
    "EXT_BSC_GAS_TOPUP_WEI": "800000000000000",
    // The real address ALL user deposits sweep into (owner's BNB wallet).
    "EXT_SWEEP_DESTINATION": "0x633ECc295Bc8F9068051443BF748929a3eE5119E",
    // Skip sweeping dust below this many USDT.
    "EXT_SWEEP_MIN_USDT": "1"

    // SECRETS (do NOT put in this file — set via `wrangler secret put` or the
    // dashboard on the quantaex-cron Worker):
    //   QTA_HD_WALLET_MNEMONIC  — 12-word BIP-39 mnemonic; index 0 must derive
    //                             to QTA_HOT_WALLET_ADDRESS above.
    //   QTA_CHAIN_DRIVER=real   — flip on when ready to broadcast.
    //   EXT_HD_WALLET_MNEMONIC  — 24-word BIP-39 mnemonic for external deposits.
    //                             index 1..N = per-user BSC addresses; index 0
    //                             holds no funds (sweeps go to EXT_SWEEP_DESTINATION).
    //   EXT_BSC_EXPLORER_API_KEY — Etherscan V2 PAID API key (BSC chain access).
    //   EXT_DEPOSITS_ENABLED     — "true" to activate the watcher + sweeper.
  }
}
